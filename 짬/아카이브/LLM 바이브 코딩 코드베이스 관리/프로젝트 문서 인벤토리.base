filters:
  and:
    - file.inFolder("짬/아카이브/LLM 바이브 코딩 코드베이스 관리")
    - file.ext == "md"
formulas:
  folder_label: |
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리", "🏠 홈",
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리/컨텍스트 맵과 도메인 안전 경계", "🗺️ 컨텍스트 맵",
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리/컨텍스트 맵과 도메인 안전 경계/DDD 영감 도메인 안전 계층", "🗺️ DDD 계층",
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리/작업 프로토콜", "⚙️ 작업 프로토콜",
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리/LLM 친화적 코드베이스 기준", "📋 코드베이스 기준",
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리/외부 레퍼런스", "📚 외부 레퍼런스",
    "📄 기타"))))))
properties:
  file.name:
    displayName: 문서명
  formula.folder_label:
    displayName: 영역
  status:
    displayName: 상태
  file.mtime:
    displayName: 수정일
  file.size:
    displayName: 크기
views:
  - type: table
    name: 모든 문서 (표)
    groupBy:
      property: formula.folder_label
      direction: ASC
    order:
      - formula.folder_label
      - file.name
      - status
      - file.mtime
      - file.size
