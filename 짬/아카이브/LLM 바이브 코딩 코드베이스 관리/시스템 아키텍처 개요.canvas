    {
      "id": "622c9143a7edfcd7",
      "type": "text",
      "x": 385,
      "y": 120,
      "width": 190,
      "height": 70,
      "text": "#### Context Builder\nmanifest, topology, symbols\n→ Context Pack",
      "color": "1"
    },
    {
      "id": "afc63629ade286b9",
      "type": "text",
      "x": 600,
      "y": 120,
      "width": 190,
      "height": 70,
      "text": "#### Pre-Write Guard\nAdvisory: block / warning\n→ 구조적 위험 감지",
      "color": "2"
    },
    {
      "id": "df2f1306b08e402d",
      "type": "text",
      "x": 815,
      "y": 120,
      "width": 190,
      "height": 70,
      "text": "#### Patch Executor\nApproved plan → Small diff\n→ 승인 범위 내 변경",
      "color": "3"
    },
    {
      "id": "fd529e8b3d3ef0b2",
      "type": "text",
      "x": 1030,
      "y": 120,
      "width": 190,
      "height": 70,
      "text": "#### Verification Router\nTests + Typecheck + Lint\n+ Structural audit",
      "color": "4"
    },
    {
      "id": "a5d8e6ab081f43fa",
      "type": "text",
      "x": 385,
      "y": 210,
      "width": 250,
      "height": 55,
      "text": "lumin-repo-lens\nCore Evidence Provider",
      "color": "5"
    },
    {
      "id": "1481de7c37dbb926",
      "type": "text",
      "x": 370,
      "y": 310,
      "width": 150,
      "height": 60,
      "text": "도입 순서\nAGENTS.md → 검증 명령\n→ 테스트 → evidence",
      "color": "3"
    },
    {
      "id": "40cf84f107429537",
      "type": "text",
      "x": 540,
      "y": 310,
      "width": 150,
      "height": 60,
      "text": "중복 판단 모델\n구조/경계/계약/의미\n→ 7가지 결론",
      "color": "2"
    },
    {
      "id": "7978e70be06f17da",
      "type": "text",
      "x": 710,
      "y": 310,
      "width": 150,
      "height": 60,
      "text": "CI Rollout\nadvisory → blocking\n→ full gate",
      "color": "1"
    },
    {
      "id": "3fb9270e9c1e98a9",
      "type": "text",
      "x": 880,
      "y": 310,
      "width": 150,
      "height": 60,
      "text": "반복 실수 흡수\nAGENTS.md → 테스트\n→ lint → evidence",
      "color": "6"
    },
    {
      "id": "cce630a735fd2814",
      "type": "group",
      "x": 1340,
      "y": 0,
      "width": 310,
      "height": 480,
      "label": "🔄 경량 라이프사이클 엔진",
      "color": "6"
    },
    {
      "id": "eb4e33292dac6d21",
      "type": "text",
      "x": 1360,
      "y": 30,
      "width": 270,
      "height": 50,
      "text": "1. Context 선택\nproject note / context index",
      "color": "2"
    },
    {
      "id": "e4e1f3c656e817e4",
      "type": "text",
      "x": 1360,
      "y": 95,
      "width": 270,
      "height": 50,
      "text": "2. 요구사항 구조화\n성공 신호 / 다루지 않을 것",
      "color": "3"
    },
    {
      "id": "19b48a3ed11a8da9",
      "type": "text",
      "x": 1360,
      "y": 160,
      "width": 270,
      "height": 50,
      "text": "3. 최소 slice 선택\nin scope / out of scope",
      "color": "4"
    },
    {
      "id": "445a87d26a3fb275",
      "type": "text",
      "x": 1360,
      "y": 225,
      "width": 270,
      "height": 50,
      "text": "4. 중단 조건 검사\n모호하면 handoff 금지",
      "color": "1"
    },
    {
      "id": "874e73252684c1e0",
      "type": "text",
      "x": 1360,
      "y": 290,
      "width": 270,
      "height": 50,
      "text": "5. handoff prompt\n작은 계약 / 검증 기대치",
      "color": "5"
    },
    {
      "id": "9a3c588e701169b9",
      "type": "text",
      "x": 1360,
      "y": 355,
      "width": 270,
      "height": 50,
      "text": "6. 구현 에이전트 실행",
      "color": "3"
    },
    {
      "id": "04485438cd2928ad",
      "type": "text",
      "x": 1360,
      "y": 420,
      "width": 270,
      "height": 50,
      "text": "7. 결과 → Obsidian 환류\nevidence / context gap 기록",
      "color": "6"
    }
