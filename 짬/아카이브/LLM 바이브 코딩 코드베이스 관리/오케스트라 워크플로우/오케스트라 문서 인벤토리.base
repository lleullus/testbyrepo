filters:
  and:
    - file.inFolder("짬/아카이브/LLM 바이브 코딩 코드베이스 관리/오케스트라 워크플로우")
    - file.ext == "md"
formulas:
  area_label: |
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리/오케스트라 워크플로우", "🏠 홈",
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리/오케스트라 워크플로우/핵심 계약", "📜 핵심 계약",
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리/오케스트라 워크플로우/Phase 0", "🔶 Phase 0",
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리/오케스트라 워크플로우/Phase 1", "🔷 Phase 1",
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리/오케스트라 워크플로우/Phase 2", "🟢 Phase 2",
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리/오케스트라 워크플로우/에이전트 검수 기준", "📋 검수 기준",
    if(file.folder == "짬/아카이브/LLM 바이브 코딩 코드베이스 관리/오케스트라 워크플로우/참조 템플릿", "📎 참조 템플릿",
    "📄 기타")))))))
properties:
  file.name:
    displayName: 문서명
  formula.area_label:
    displayName: 영역
  status:
    displayName: 상태
  file.mtime:
    displayName: 수정일
views:
  - type: table
    name: 전체 문서
    groupBy:
      property: formula.area_label
      direction: ASC
    order:
      - formula.area_label
      - file.name
      - status
      - file.mtime
